# =======================
# FOKUS İSTATİSTİK - ENVIRONMENT VARIABLES
# =======================
# Bu dosyayı kopyalayıp .env.local olarak kaydedin
# Hassas bilgiler asla Git'e commit edilmemelidir!

# =======================
# GOOGLE AUTHENTICATION
# =======================
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =======================
# NEXT AUTH
# =======================
# Production URL (değiştirin!)
NEXTAUTH_URL=https://fokusistatistik.com
# Random secret key oluşturun: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# =======================
# GOOGLE ANALYTICS
# =======================
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WNKZVMGKBF

# =======================
# GOOGLE SITE VERIFICATION
# =======================
# Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# =======================
# N8N WEBHOOK URLS
# =======================
# N8N webhook base URL (değiştirmeyin, sadece bilgi için)
# https://n8n.fokusistatistik.com/webhook/*
N8N_WEBHOOK_URL=your-n8n-webhook-url

# =======================
# SECURITY
# =======================
# Webhook signature validation secret
# Random secret key: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-key

# =======================
# API CONFIGURATION
# =======================
# Rate limiting (optional)
# API_RATE_LIMIT=100

# =======================
# SENTRY ERROR TRACKING
# =======================
# Kurulum: https://sentry.io
# Production DSN (already configured)
NEXT_PUBLIC_SENTRY_DSN=https://196e6d84f952f2459e7c02e17e563b46@o4510357778333696.ingest.de.sentry.io/4510357789343824
# Auth token (source maps upload için - opsiyonel)
SENTRY_AUTH_TOKEN=your-sentry-auth-token-if-needed

# =======================
# FEATURE FLAGS (Optional)
# =======================
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CHATBOT=true
