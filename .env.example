# ========================================
# FOKUS İstatistik - Environment Variables
# ========================================
# Bu dosya environment variables template'dir.
# Production için .env.local oluşturun ve değerleri doldurun.

# ========================================
# Google Analytics 4 (GA4)
# ========================================
# Dual tracking - iki measurement ID kullanılıyor
# Dashboard: https://analytics.google.com/

# Google Tag ID (ana etiket - birden fazla hedefe veri gönderir)
NEXT_PUBLIC_GA_TAG_ID=G-WNKZVMGKBF

# GA4 Measurement ID (spesifik akış - stream ID: 13013000691)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Y1KQHRL4NV

# Google Site Verification (Search Console için)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# ========================================
# Google reCAPTCHA v3
# ========================================
# Spam ve bot koruması için
# Setup: https://www.google.com/recaptcha/admin/create
# Tip: reCAPTCHA v3 seçin (v2 değil!)
# Domains: localhost, fokusistatistik.com, www.fokusistatistik.com

# Site Key (public - frontend'de kullanılır, herkes görebilir)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc...your_site_key_here

# Secret Key (private - ASLA public etmeyin! Sadece backend'de kullanılır)
RECAPTCHA_SECRET_KEY=6Lc...your_secret_key_here

# ========================================
# n8n Webhook URLs
# ========================================
# n8n automation workflows için webhook endpoints

# İletişim formu webhook (public - frontend'de kullanılır)
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK=https://n8n.fokusistatistik.com/webhook/contact

# Analiz formu webhook (hardcoded in code, buraya reference için)
# https://n8n.fokusistatistik.com/webhook/analizformu

# Ana webhook URL (genel kullanım - private)
N8N_WEBHOOK_URL=https://n8n.fokusistatistik.com/webhook/main

# Auth webhook (OAuth flow sonrası kullanıcı kaydı)
NEXT_PUBLIC_AUTH_WEBHOOK_URL=https://n8n.fokusistatistik.com/webhook/auth

# ========================================
# Google OAuth 2.0
# ========================================
# Google ile giriş için
# Setup: https://console.cloud.google.com/apis/credentials

# Client ID (public)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Client Secret (private - ASLA public etmeyin!)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# JWT Secret (Session Token Güvenliği)
# ========================================
# Admin session token'larını imzalamak için kullanılır
# ÖNEMLI: Production'da mutlaka güçlü, rastgele bir değer kullanın!
# Örnek oluşturma: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=change-this-to-a-strong-random-secret-in-production-at-least-32-characters-long

# ========================================
# Site Configuration
# ========================================
# Production site URL (trailing slash olmadan)
NEXT_PUBLIC_URL=https://fokusistatistik.com

# ========================================
# NOTLAR
# ========================================
# 1. NEXT_PUBLIC_ prefix'li değişkenler frontend'de görünür
# 2. Prefix'siz değişkenler sadece server-side'da kullanılır
# 3. .env.local dosyası .gitignore'da - asla commit etmeyin!
# 4. Production'da Vercel/platform env variables kullanın
# 5. Development için .env.local oluşturun:
#    cp .env.example .env.local
#    nano .env.local
