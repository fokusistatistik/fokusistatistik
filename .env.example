# Site URL
NEXT_PUBLIC_URL=http://localhost:3000

# Google OAuth Configuration
# Google Cloud Console'dan alınacak: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Webhook Configuration
# Auth webhook URL - Kullanıcı giriş/kayıt için n8n webhook endpoint'i
# Bu webhook code'u token'a çevirir ve user bilgilerini döndürür
NEXT_PUBLIC_AUTH_WEBHOOK_URL=https://n8n.fokusistatistik.com/webhook-test/fokuswebuserauth

# Database (eğer kullanılacaksa)
# DATABASE_URL=postgresql://user:password@localhost:5432/fokusdb

# Diğer API Keys
# OPENAI_API_KEY=your-openai-api-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
