# =======================
# FOKUS İSTATİSTİK - ENVIRONMENT VARIABLES
# =======================
# Bu dosyayı kopyalayıp .env.local olarak kaydedin
# Hassas bilgiler asla Git'e commit edilmemelidir!

# =======================
# GOOGLE AUTHENTICATION
# =======================
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =======================
# NEXT AUTH
# =======================
# Production URL (değiştirin!)
NEXTAUTH_URL=https://fokusistatistik.com
# Random secret key oluşturun: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# =======================
# GOOGLE ANALYTICS
# =======================
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WNKZVMGKBF

# =======================
# GOOGLE SITE VERIFICATION
# =======================
# Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# =======================
# N8N WEBHOOK URLS
# =======================
# N8N webhook base URL (değiştirmeyin, sadece bilgi için)
# https://n8n.fokusistatistik.com/webhook/*

# =======================
# API CONFIGURATION
# =======================
# Rate limiting (optional)
# API_RATE_LIMIT=100

# =======================
# SENTRY ERROR TRACKING (Optional)
# =======================
# Sentry DSN (hata izleme için)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# =======================
# FEATURE FLAGS (Optional)
# =======================
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CHATBOT=true
